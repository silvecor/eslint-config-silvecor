{
  "name": "eslint-config-silvecor",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.8.0",
  "description": "ESLint config for @silvecor projects.",
  "author": "Silver Chloride <me@silvecor.dev>",
  "license": "MIT",
  "homepage": "https://github.com/silvecor/eslint-config-silvecor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silvecor/eslint-config-silvecor.git"
  },
  "keywords": [
    "eslint",
    "eslint-config"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "eslint-config-inspector --config eslint-inspector.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bumpp"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "dependencies": {
    "@e18e/eslint-plugin": "^0.5.1",
    "@eslint-react/eslint-plugin": "^5.18.7",
    "@next/eslint-plugin-next": "^16.3.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "defu": "^6.1.7",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-plugin-command": "^4.0.0",
    "eslint-plugin-de-morgan": "^2.1.3",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-toml": "^1.5.0",
    "eslint-plugin-unicorn": "^68.0.0",
    "eslint-plugin-yml": "^3.8.1",
    "globals": "^17.11.0",
    "jsonc-eslint-parser": "^3.3.0",
    "toml-eslint-parser": "^1.0.3",
    "yaml-eslint-parser": "^2.1.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/config-inspector": "^3.3.0",
    "@types/node": "^25.9.5",
    "bumpp": "^11.1.0",
    "commitlint": "^21.2.2",
    "eslint": "^10.9.1",
    "lefthook": "^2.1.12",
    "lint-staged": "^17.4.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
